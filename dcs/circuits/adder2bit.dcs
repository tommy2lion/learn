inputs: A0, A1, B0, B1, Cin
outputs: S0, S1, Cout

# Bit 0: Full Adder (A0 + B0 + Cin)
not_A0    = not(A0)
not_B0    = not(B0)
not_Cin   = not(Cin)

xor0_a    = and(A0, not_B0)
xor0_b    = and(not_A0, B0)
XOR0      = or(xor0_a, xor0_b)         # A0 XOR B0

not_XOR0  = not(XOR0)
s0_a      = and(XOR0, not_Cin)
s0_b      = and(not_XOR0, Cin)
S0        = or(s0_a, s0_b)             # S0 = A0 XOR B0 XOR Cin

carry0_a  = and(A0, B0)
carry0_b  = and(Cin, XOR0)
Cout0     = or(carry0_a, carry0_b)     # carry to bit 1

# Bit 1: Full Adder (A1 + B1 + Cout0)
not_A1    = not(A1)
not_B1    = not(B1)
not_Cout0 = not(Cout0)

xor1_a    = and(A1, not_B1)
xor1_b    = and(not_A1, B1)
XOR1      = or(xor1_a, xor1_b)         # A1 XOR B1

not_XOR1  = not(XOR1)
s1_a      = and(XOR1, not_Cout0)
s1_b      = and(not_XOR1, Cout0)
S1        = or(s1_a, s1_b)             # S1 = A1 XOR B1 XOR Cout0

cout_a    = and(A1, B1)
cout_b    = and(Cout0, XOR1)
Cout      = or(cout_a, cout_b)         # final carry-out
