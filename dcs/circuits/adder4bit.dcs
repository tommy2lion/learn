inputs: A0, A1, A2, A3, B0, B1, B2, B3, Cin
outputs: S0, S1, S2, S3, Cout

# Bit 0
nA0  = not(A0)
nB0  = not(B0)
x0a  = and(A0, nB0)
x0b  = and(nA0, B0)
X0   = or(x0a, x0b)
nX0  = not(X0)
nC0  = not(Cin)
s0a  = and(X0, nC0)
s0b  = and(nX0, Cin)
S0   = or(s0a, s0b)
c0a  = and(A0, B0)
c0b  = and(Cin, X0)
C1   = or(c0a, c0b)

# Bit 1
nA1  = not(A1)
nB1  = not(B1)
x1a  = and(A1, nB1)
x1b  = and(nA1, B1)
X1   = or(x1a, x1b)
nX1  = not(X1)
nC1  = not(C1)
s1a  = and(X1, nC1)
s1b  = and(nX1, C1)
S1   = or(s1a, s1b)
c1a  = and(A1, B1)
c1b  = and(C1, X1)
C2   = or(c1a, c1b)

# Bit 2
nA2  = not(A2)
nB2  = not(B2)
x2a  = and(A2, nB2)
x2b  = and(nA2, B2)
X2   = or(x2a, x2b)
nX2  = not(X2)
nC2  = not(C2)
s2a  = and(X2, nC2)
s2b  = and(nX2, C2)
S2   = or(s2a, s2b)
c2a  = and(A2, B2)
c2b  = and(C2, X2)
C3   = or(c2a, c2b)

# Bit 3
nA3  = not(A3)
nB3  = not(B3)
x3a  = and(A3, nB3)
x3b  = and(nA3, B3)
X3   = or(x3a, x3b)
nX3  = not(X3)
nC3  = not(C3)
s3a  = and(X3, nC3)
s3b  = and(nX3, C3)
S3   = or(s3a, s3b)
c3a  = and(A3, B3)
c3b  = and(C3, X3)
Cout = or(c3a, c3b)
