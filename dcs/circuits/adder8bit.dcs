inputs: A0, A1, A2, A3, A4, A5, A6, A7, B0, B1, B2, B3, B4, B5, B6, B7
outputs: S0, S1, S2, S3, S4, S5, S6, S7, Cout

# Bit 0 (Half Adder, Cin=0)
nA0  = not(A0)
nB0  = not(B0)
s0a  = and(A0, nB0)
s0b  = and(nA0, B0)
S0   = or(s0a, s0b)
C1   = and(A0, B0)

# Bit 1
nA1  = not(A1)
nB1  = not(B1)
x1a  = and(A1, nB1)
x1b  = and(nA1, B1)
X1   = or(x1a, x1b)
nX1  = not(X1)
nC1  = not(C1)
s1a  = and(X1, nC1)
s1b  = and(nX1, C1)
S1   = or(s1a, s1b)
c1a  = and(A1, B1)
c1b  = and(C1, X1)
C2   = or(c1a, c1b)

# Bit 2
nA2  = not(A2)
nB2  = not(B2)
x2a  = and(A2, nB2)
x2b  = and(nA2, B2)
X2   = or(x2a, x2b)
nX2  = not(X2)
nC2  = not(C2)
s2a  = and(X2, nC2)
s2b  = and(nX2, C2)
S2   = or(s2a, s2b)
c2a  = and(A2, B2)
c2b  = and(C2, X2)
C3   = or(c2a, c2b)

# Bit 3
nA3  = not(A3)
nB3  = not(B3)
x3a  = and(A3, nB3)
x3b  = and(nA3, B3)
X3   = or(x3a, x3b)
nX3  = not(X3)
nC3  = not(C3)
s3a  = and(X3, nC3)
s3b  = and(nX3, C3)
S3   = or(s3a, s3b)
c3a  = and(A3, B3)
c3b  = and(C3, X3)
C4   = or(c3a, c3b)

# Bit 4
nA4  = not(A4)
nB4  = not(B4)
x4a  = and(A4, nB4)
x4b  = and(nA4, B4)
X4   = or(x4a, x4b)
nX4  = not(X4)
nC4  = not(C4)
s4a  = and(X4, nC4)
s4b  = and(nX4, C4)
S4   = or(s4a, s4b)
c4a  = and(A4, B4)
c4b  = and(C4, X4)
C5   = or(c4a, c4b)

# Bit 5
nA5  = not(A5)
nB5  = not(B5)
x5a  = and(A5, nB5)
x5b  = and(nA5, B5)
X5   = or(x5a, x5b)
nX5  = not(X5)
nC5  = not(C5)
s5a  = and(X5, nC5)
s5b  = and(nX5, C5)
S5   = or(s5a, s5b)
c5a  = and(A5, B5)
c5b  = and(C5, X5)
C6   = or(c5a, c5b)

# Bit 6
nA6  = not(A6)
nB6  = not(B6)
x6a  = and(A6, nB6)
x6b  = and(nA6, B6)
X6   = or(x6a, x6b)
nX6  = not(X6)
nC6  = not(C6)
s6a  = and(X6, nC6)
s6b  = and(nX6, C6)
S6   = or(s6a, s6b)
c6a  = and(A6, B6)
c6b  = and(C6, X6)
C7   = or(c6a, c6b)

# Bit 7
nA7  = not(A7)
nB7  = not(B7)
x7a  = and(A7, nB7)
x7b  = and(nA7, B7)
X7   = or(x7a, x7b)
nX7  = not(X7)
nC7  = not(C7)
s7a  = and(X7, nC7)
s7b  = and(nX7, C7)
S7   = or(s7a, s7b)
c7a  = and(A7, B7)
c7b  = and(C7, X7)
Cout = or(c7a, c7b)
