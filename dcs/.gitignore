# resume.txt
resume.txt

# R-15 part 2: regenerated by Makefile on every build; date + git short
# hash change every checkout, so don't track it.
src/build_info.c

# R-15 part 3: personal build-time secrets (DCS_BUILD_SALT, etc.).
# Use .env.example as a template; copy to .env and customise.
.env

# build.sh mode-tracking sentinel — tells the script whether the last
# build was release or debug, so a mode switch can force -B.
.build_mode
